# ============================================================
# Eatwise — AI Meal Planner
# Переменные окружения (.env)
# Скопируйте этот файл в .env и заполните значения.
# ============================================================

# --- База данных (PostgreSQL) ---
# Формат: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# --- NextAuth ---
# Случайная строка ≥32 символа. Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET=
# NEXTAUTH_URL задаётся автоматически платформой при деплое.
# Локально можно указать: http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000

# --- Abacus AI API (ИИ-генерация планов, уведомления, PDF) ---
# Получить: https://apps.abacus.ai/chatllm/admin/api-keys
ABACUSAI_API_KEY=

# --- Stripe (платежи / подписки) ---
# Получить: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook secret для верификации событий Stripe
# Получить: https://dashboard.stripe.com/webhooks → ваш эндпоинт → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Telegram-бот ---
# Получить у @BotFather: /newbot
TELEGRAM_BOT_TOKEN=
# Любая случайная строка для защиты вебхука. Сгенерировать: openssl rand -hex 20
TELEGRAM_WEBHOOK_SECRET=
# (Опционально) Системный бот для служебных уведомлений
TELEGRAM_SYSTEM_BOT_TOKEN=
# Chat ID администратора (для уведомлений). Узнать: отправьте /start боту @userinfobot
TELEGRAM_ADMIN_CHAT_ID=

# --- Google Analytics ---
# Получить: https://analytics.google.com/ → Администрирование → Потоки данных → ID потока (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Уведомления (Abacus Notification IDs) ---
# Эти ID создаются автоматически при регистрации типов уведомлений через Abacus AI.
# Если вы запускаете проект вне Abacus AI, эти переменные можно оставить пустыми —
# email-уведомления просто не будут отправляться.
NOTIF_ID_PASSWORD_RESET=
NOTIF_ID_NEW_SUPPORT_REQUEST=
NOTIF_ID_SUPPORT_REPLY=
NOTIF_ID_ONBOARDING_REMINDER=
NOTIF_ID_MEAL_PLAN_REMINDER=
NOTIF_ID_WEEKLY_PLAN_REMINDER=

# --- Служебное (Abacus AI) ---
# ID веб-приложения на платформе Abacus AI
WEB_APP_ID=
